{
  "name": "kyle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k 'tsx watch src/server/index.ts' 'vite --host 0.0.0.0'",
    "start": "node --import tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts *.json *.ts",
    "check:format": "prettier --check src tests scripts *.json *.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fullcalendar/react": "^7.1.3",
    "fastify": "^5.12.7",
    "ical.js": "^2.2.1",
    "ipaddr.js": "^2.5.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
